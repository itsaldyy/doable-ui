# Automatically load Node.js version from .nvmrc
# This file is used by direnv (https://direnv.net/)
# Install direnv and run 'direnv allow' to enable automatic version switching

# Load nvm and use the version specified in .nvmrc
if [ -f .nvmrc ]; then
    # Check if nvm is available
    if [ -s "$NVM_DIR/nvm.sh" ]; then
        source "$NVM_DIR/nvm.sh"
        nvm use
    else
        # Fallback to .nvmrc-loader.sh
        source .nvmrc-loader.sh
    fi
fi
