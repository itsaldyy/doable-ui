# Automatically load Node.js version from .nvmrc
# This file is used by direnv (https://direnv.net/)
# Install direnv and run 'direnv allow' to enable automatic version switching

# Silence direnv's verbose output
export DIRENV_LOG_FORMAT=""

# Preserve VS Code/IDE terminal integration
_SAVED_PROMPT_COMMAND="$PROMPT_COMMAND"

# Save the current Node version before switching
_PREVIOUS_NODE_VERSION=$(node -v 2>/dev/null || echo "none")

# Load nvm and use the version specified in .nvmrc
if [ -f .nvmrc ]; then
    REQUIRED_VERSION=$(cat .nvmrc | tr -d '[:space:]')

    # Check if nvm is available
    if [ -s "$NVM_DIR/nvm.sh" ]; then
        source "$NVM_DIR/nvm.sh"

        # Switch to required version silently
        nvm use --silent 2>/dev/null || nvm use --silent

        # Get the new version
        _NEW_NODE_VERSION=$(node -v 2>/dev/null)

        # Show informative message only if version changed
        if [ "$_PREVIOUS_NODE_VERSION" != "$_NEW_NODE_VERSION" ]; then
            echo "🔄 Node.js: $_PREVIOUS_NODE_VERSION → $_NEW_NODE_VERSION (project requires v$REQUIRED_VERSION)"
        fi
    else
        # Fallback to .nvmrc-loader.sh
        source .nvmrc-loader.sh
    fi
fi

# Restore PROMPT_COMMAND if it was cleared by nvm
if [ -n "$_SAVED_PROMPT_COMMAND" ] && [ -z "$PROMPT_COMMAND" ]; then
    export PROMPT_COMMAND="$_SAVED_PROMPT_COMMAND"
fi

# Clean up temporary variables
unset _SAVED_PROMPT_COMMAND
unset _PREVIOUS_NODE_VERSION
unset _NEW_NODE_VERSION
